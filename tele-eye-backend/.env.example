# Example backend environment variables
# Copy this file to .env and fill values before running backend.
#
# SePay webhook auth:
# - The app accepts either SEPAY_API_KEY or SEPAY_WEBHOOK_TOKEN.
# - SEPAY_ACCOUNT_NUMBER is optional, used to narrow SePay API reconciliation.
# - It also accepts Authorization header formats:
#   "<token>", "Apikey <token>", or "Bearer <token>".
SEPAY_API_KEY=your_sepay_api_key_here
# SEPAY_WEBHOOK_TOKEN=your_sepay_webhook_token_here
SEPAY_ACCOUNT_NUMBER=your_bank_account_number_here
PORT=8080
# Optional: if you want to use ngrok, set your ngrok auth token here
# NGROK_AUTHTOKEN=your_ngrok_auth_token_here
